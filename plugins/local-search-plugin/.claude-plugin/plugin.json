{
  "name": "local-search-plugin",
  "description": "ローカルPCのドキュメント (Markdown/テキスト/PDF/Office) を全文検索とRAG検索で横断検索し、本文ではなくパスと行番号だけを返すMCPプラグイン",
  "version": "1.0.0",
  "author": {
    "name": "MetalMental",
    "email": "flupino@metalmental.net",
    "url": "https://github.com/Flupinochan"
  },
  "homepage": "https://www.metalmental.net/",
  "repository": "https://github.com/Flupinochan/metalmental-claude",
  "license": "MIT",
  "keywords": [
    "local-search",
    "full-text-search",
    "rag",
    "sqlite",
    "mcp"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "local-search": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp-server-local-search",
        "mcp-server-local-search",
        "--data-dir",
        "${CLAUDE_PLUGIN_DATA}"
      ]
    }
  }
}
