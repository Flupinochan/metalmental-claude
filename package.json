{
  "name": "metalmental-claude",
  "private": true,
  "scripts": {
    "format": "prettier --write \"plugins/{statusline,ui-plus}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"plugins/{statusline,ui-plus}/**/*.{ts,tsx}\"",
    "lint": "eslint --fix \"plugins/{statusline,ui-plus}/**/*.{ts,tsx}\"",
    "lint:check": "eslint \"plugins/{statusline,ui-plus}/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.3.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
